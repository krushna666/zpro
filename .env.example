# ============================================================
# BusGo Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# --- Core ---
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
ADMIN_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Database ---
DATABASE_URL=postgresql://busgo:busgo_dev_password@localhost:5432/busgo?schema=public
POSTGRES_USER=busgo
POSTGRES_PASSWORD=busgo_dev_password
POSTGRES_DB=busgo

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_ACCESS_SECRET=REQUIRED_SECRET_change_me_access
JWT_REFRESH_SECRET=REQUIRED_SECRET_change_me_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Seat locking ---
SEAT_LOCK_TTL_SECONDS=300

# --- Razorpay (REQUIRED for real payments) ---
RAZORPAY_KEY_ID=REQUIRED_SECRET_razorpay_key_id
RAZORPAY_KEY_SECRET=REQUIRED_SECRET_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=REQUIRED_SECRET_razorpay_webhook_secret

# --- File storage (Supabase / S3-compatible) ---
SUPABASE_URL=REQUIRED_SECRET_supabase_url
SUPABASE_SERVICE_ROLE_KEY=REQUIRED_SECRET_supabase_service_role_key
STORAGE_BUCKET=busgo

# --- Firebase Cloud Messaging ---
FIREBASE_PROJECT_ID=REQUIRED_SECRET_firebase_project_id
FIREBASE_CLIENT_EMAIL=REQUIRED_SECRET_firebase_client_email
FIREBASE_PRIVATE_KEY=REQUIRED_SECRET_firebase_private_key

# --- Google Maps (server-side, restricted key) ---
GOOGLE_MAPS_API_KEY=REQUIRED_SECRET_google_maps_server_key

# --- Email (SMTP / Resend / SendGrid) ---
EMAIL_PROVIDER=smtp
SMTP_HOST=REQUIRED_SECRET_smtp_host
SMTP_PORT=587
SMTP_USER=REQUIRED_SECRET_smtp_user
SMTP_PASSWORD=REQUIRED_SECRET_smtp_password
SMTP_FROM="BusGo <no-reply@busgo.app>"
RESEND_API_KEY=REQUIRED_SECRET_resend_api_key
SENDGRID_API_KEY=REQUIRED_SECRET_sendgrid_api_key

# --- WhatsApp ---
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=REQUIRED_SECRET_twilio_account_sid
TWILIO_AUTH_TOKEN=REQUIRED_SECRET_twilio_auth_token
TWILIO_WHATSAPP_FROM=REQUIRED_SECRET_twilio_whatsapp_from
META_WHATSAPP_TOKEN=REQUIRED_SECRET_meta_whatsapp_token
META_WHATSAPP_PHONE_ID=REQUIRED_SECRET_meta_whatsapp_phone_id

# --- Logging ---
LOG_LEVEL=info

# --- Mock mode (development ONLY — must never be true in production) ---
MOCK_PAYMENTS=true
MOCK_OTP=true
MOCK_EMAIL=true
MOCK_WHATSAPP=true
MOCK_MAPS=false
DEV_OTP_CODE=123456

# --- Admin panel ---
VITE_API_BASE_URL=http://localhost:4000/api/v1

# --- Android (local.properties, not this file) ---
# ANDROID_GOOGLE_MAPS_API_KEY=REQUIRED_SECRET_google_maps_android_key (restricted, client-safe)
